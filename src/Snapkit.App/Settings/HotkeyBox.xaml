<!-- Поле сочетания клавиш: щелчок — «Нажмите сочетание…», само сочетание ловит перехват клавиатуры -->
<UserControl x:Class="Snapkit.App.Settings.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Frame" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="10,7" Cursor="Hand" MouseLeftButtonUp="Frame_MouseLeftButtonUp">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="Hint" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
            <StackPanel x:Name="Keys" Orientation="Horizontal" VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
