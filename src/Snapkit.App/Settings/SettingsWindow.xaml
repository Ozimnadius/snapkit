<!-- Окно «Настройки»: вкладки «Общие / Клавиши / Сохранение / Вид», как на наброске settings-tabs.html -->
<Window x:Class="Snapkit.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Snapkit.App.Shell"
        xmlns:settings="clr-namespace:Snapkit.App.Settings"
        Title="Snapkit — настройки"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <shell:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />

        <!-- Вкладка — кнопка-переключатель -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="7" Padding="14,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Галочка в цветах темы -->
        <Style x:Key="SettingsCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource MutedTextBrush}" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-ссылка: «Отмена», «Удалить Snapkit с компьютера…» -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка темы с превью -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="150" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}"
                                CornerRadius="9" Padding="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кружок цвета программы: заливка — Background -->
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="30" Height="30">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,2,0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22,16,22,18">
        <StackPanel>
            <!-- Заголовок: за него окно перетаскивается -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,14">
                <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Content="&#xE8BB;" ToolTip="Закрыть"
                        Click="Cancel_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="GeneralTab" Style="{StaticResource TabButton}" GroupName="tabs" Content="Общие" Checked="Tab_Checked" />
                <RadioButton x:Name="KeysTab" Style="{StaticResource TabButton}" GroupName="tabs" Content="Клавиши" Checked="Tab_Checked" />
                <RadioButton x:Name="SaveTab" Style="{StaticResource TabButton}" GroupName="tabs" Content="Сохранение" Checked="Tab_Checked" />
                <RadioButton x:Name="LookTab" Style="{StaticResource TabButton}" GroupName="tabs" Content="Вид" Checked="Tab_Checked" />
            </StackPanel>

            <Grid MinHeight="330">
                <!-- Общие -->
                <StackPanel x:Name="GeneralPanel">
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding LaunchAtStartup}" Content="Открывать при включении компьютера" />
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding ShowNotifications}" Content="Показывать уведомления" />
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding ShowStrip}" Content="Показывать ленту" />
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding ClearStripAfterPaste}" Content="Очищать ленту после вставки" />
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding ProposeLastRegion}" Content="Предлагать ту же область, что в прошлый раз" />
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding ShowCursor}" Content="Показывать курсор мыши на снимке" />
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding AutoUpdate}" Content="Обновлять автоматически" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="CheckUpdatesSeparator" Text=" · " FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource LinkButton}" FontSize="12" Content="Проверить обновления"
                                IsEnabled="{Binding Updates.IsIdle, FallbackValue=False}" Click="CheckUpdates_Click" />
                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Style="{StaticResource LinkButton}" FontSize="12" Content="Удалить Snapkit с компьютера…" Click="Uninstall_Click" />
                    </StackPanel>
                    <!-- Ответ проверки: виден после щелчка по «Проверить обновления» -->
                    <StackPanel x:Name="UpdatePanel" Orientation="Horizontal" Margin="0,10,0,0" MinHeight="26" Visibility="Collapsed">
                        <TextBlock x:Name="UpdateStatusText" Text="{Binding Updates.Status}" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Button x:Name="UpdateActionButton" Content="{Binding Updates.ActionText}" Margin="12,0,0,0" Height="26"
                                FontSize="12" Padding="12,0" IsEnabled="{Binding Updates.IsIdle}" Click="UpdateAction_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Updates.ActionText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Клавиши -->
                <StackPanel x:Name="KeysPanel" Visibility="Collapsed">
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding CaptureEnabled}" Content="Снимок области" />
                    <settings:HotkeyBox x:Name="Region1Box" Hotkey="{Binding Region1}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyErrors[0]}"
                               Visibility="{Binding HotkeyErrors[0], Converter={StaticResource NotNullToVisibility}}" />
                    <settings:HotkeyBox x:Name="Region2Box" Hotkey="{Binding Region2}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyErrors[1]}"
                               Visibility="{Binding HotkeyErrors[1], Converter={StaticResource NotNullToVisibility}}" />

                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding FullScreenEnabled}" Content="Снимок всего экрана" Margin="0,16,0,5" />
                    <settings:HotkeyBox x:Name="Full1Box" Hotkey="{Binding Full1}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyErrors[2]}"
                               Visibility="{Binding HotkeyErrors[2], Converter={StaticResource NotNullToVisibility}}" />
                    <settings:HotkeyBox x:Name="Full2Box" Hotkey="{Binding Full2}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyErrors[3]}"
                               Visibility="{Binding HotkeyErrors[3], Converter={StaticResource NotNullToVisibility}}" />
                    <Button Style="{StaticResource SecondaryButton}" Height="32" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Content="Предложить: Ctrl+Print Screen" Click="SuggestFullScreen_Click" />
                </StackPanel>

                <!-- Сохранение -->
                <StackPanel x:Name="SavePanel" Visibility="Collapsed">
                    <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding AutoSave}" Content="Автоматически сохранять готовые снимки" />
                    <TextBlock Style="{StaticResource Label}" Text="Формат" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PngButton" Style="{StaticResource TabButton}" GroupName="format" Content="PNG" Checked="Format_Checked" />
                        <RadioButton x:Name="JpegButton" Style="{StaticResource TabButton}" GroupName="format" Content="JPEG" Checked="Format_Checked" />
                    </StackPanel>
                    <StackPanel x:Name="QualityPanel">
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="Качество JPEG · " /><Run Text="{Binding JpegQuality, Mode=OneWay}" /><Run Text=" %" />
                        </TextBlock>
                        <Slider Width="240" HorizontalAlignment="Left" Minimum="1" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1" Value="{Binding JpegQuality}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Папка сохранения" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,4,4,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Выбрать папку"
                                    Click="ChooseFolder_Click" />
                            <TextBlock Text="{Binding SaveFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Вид -->
                <StackPanel x:Name="LookPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Label}" Text="Тема" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DarkTheme" Style="{StaticResource ThemeCard}" GroupName="theme" Checked="Theme_Checked">
                            <StackPanel>
                                <Border Height="54" CornerRadius="6" Background="#2A2E37">
                                    <Border Width="30" Height="40" CornerRadius="4" Background="#1E2128" BorderBrush="#444A55" BorderThickness="1"
                                            HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Border>
                                <TextBlock Text="Тёмная" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LightTheme" Style="{StaticResource ThemeCard}" GroupName="theme" Checked="Theme_Checked">
                            <StackPanel>
                                <Border Height="54" CornerRadius="6" Background="#E9ECF1">
                                    <Border Width="30" Height="40" CornerRadius="4" Background="White" BorderBrush="#CFD4DC" BorderThickness="1"
                                            HorizontalAlignment="Right" Margin="0,0,10,0" />
                                </Border>
                                <TextBlock Text="Светлая" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SystemTheme" Style="{StaticResource ThemeCard}" GroupName="theme" Checked="Theme_Checked">
                            <StackPanel>
                                <Grid Height="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="6,0,0,6" Background="#2A2E37" />
                                    <Border Grid.Column="1" CornerRadius="0,6,6,0" Background="#E9ECF1" />
                                </Grid>
                                <TextBlock Text="Как в Windows" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="Цвет программы — кнопки, рамка выделения, кружки заметок" />
                    <WrapPanel x:Name="AccentPanel" />

                    <Border Margin="0,10,0,0" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle x:Name="SampleFrame" Width="48" Height="26" StrokeThickness="2" RadiusX="3" RadiusY="3" VerticalAlignment="Center" />
                            <Border x:Name="SamplePin" Width="22" Height="22" CornerRadius="11" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="A1" Foreground="White" FontWeight="Bold" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SampleDone" CornerRadius="7" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock Text="Готово" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="так будет выглядеть" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource LinkButton}" Content="Отмена" VerticalAlignment="Center" Margin="0,0,18,0" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Height="36" Content="Сохранить" IsEnabled="{Binding CanSave}" Click="Save_Click">
                    <Button.Style>
                        <!-- Есть ошибки в сочетаниях — кнопка бледнеет и не нажимается -->
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
