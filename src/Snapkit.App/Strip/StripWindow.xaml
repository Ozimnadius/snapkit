<Window x:Class="Snapkit.App.Strip.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Snapkit.App.Shell"
        Title="Snapkit — Лента снимков"
        Width="210" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="{Binding IsTopmost}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <shell:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="10,6,10,10">
        <StackPanel>
            <!-- Заголовок: за него окно перетаскивается -->
            <Grid Height="34" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Width="18" Height="18" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Text="Snapkit" Margin="6,0,5,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="9" MinWidth="20" Height="18"
                        Padding="6,0" VerticalAlignment="Center" ToolTip="Неотправленных снимков">
                    <TextBlock Text="{Binding UnsentCount}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Кнопки узкие: лента компактная, как у Snapik -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="22" Content="&#xE74D;" ToolTip="Очистить ленту" Click="Clear_Click" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Width="22" Content="&#xE712;" ToolTip="Ещё" Click="More_Click" />
                    <Button Style="{StaticResource IconButton}" Width="22" Content="&#xE921;" ToolTip="Свернуть" Click="Minimize_Click" />
                    <Button Style="{StaticResource IconButton}" Width="22" Content="&#xE8BB;" ToolTip="Закрыть" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Пустая лента -->
            <Border Margin="0,6,0,0" Height="96" CornerRadius="8" Background="{StaticResource PanelRaisedBrush}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="14,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <!-- Карточки стопкой, как у Snapik: по полоске каждой карточки виден сам снимок; новая — снизу и видна целиком -->
            <Border Margin="0,6,0,0" Padding="5" CornerRadius="10" Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardsList" ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{Binding TopMargin}" />
                            <Style.Triggers>
                                <!-- Наведение раскрывает карточку: она поднимается над стопкой и видна целиком -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="100" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Height="96" CornerRadius="7" BorderThickness="1"
                                    BorderBrush="#26FFFFFF" Background="{StaticResource PanelBrush}"
                                    Cursor="Hand" Tag="{Binding Id}" MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseMove="Card_PreviewMouseMove"
                                    ToolTip="Открыть снимок">
                                <Grid>
                                    <!-- Сам снимок во всю карточку, сверху: по видимой полоске его и узнают -->
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                                        </Border.Background>
                                    </Border>
                                    <!-- Буква и заметки — на маленькой полупрозрачной подложке, читаются на любом снимке -->
                                    <Border Margin="3,2,0,0" Height="22" Padding="1,1,7,1" CornerRadius="11" Background="#B31E2128"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Значок — кнопка: щелчок убирает снимок из пачки или возвращает в неё, редактор не открывается -->
                                            <Button Tag="{Binding Id}" Click="Badge_Click" ToolTip="{Binding BadgeToolTip}"
                                                    Cursor="Hand" Focusable="False">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <ContentPresenter />
                                                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="1.5" Visibility="Hidden" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="{StaticResource AccentBrush}"
                                                             Visibility="{Binding Letter, Converter={StaticResource NotNullToVisibility}}" />
                                                    <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="Bold" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse Fill="#40FFFFFF"
                                                             Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Button>
                                            <!-- Число заметок — всегда, и 0 тоже, как у Snapik -->
                                            <StackPanel Orientation="Horizontal" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE90A;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="White" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding NoteCount}" Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Кнопки карточки — при наведении, на такой же подложке справа -->
                                    <Border x:Name="CardButtons" Margin="0,2,3,0" Height="22" CornerRadius="11" Background="#B31E2128"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="12" Content="&#xE74E;" Foreground="White"
                                                    ToolTip="Сохранить снимок…" Tag="{Binding Id}" Click="Save_Click" />
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="12" Content="&#xE8C8;" Foreground="White"
                                                    ToolTip="Копировать снимок" Tag="{Binding Id}" Click="Copy_Click" />
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="22" FontSize="12" Content="&#xE8BB;" Foreground="White"
                                                    ToolTip="Удалить снимок" Tag="{Binding Id}" Click="Delete_Click" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardButtons" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.6" Color="Black" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Border>

            <TextBlock Margin="2,8,2,0" TextWrapping="Wrap" FontSize="12" Foreground="#FBBF5A"
                       Text="{Binding SoftWarningText}"
                       Visibility="{Binding ShowSoftWarning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="2,8,2,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                       Text="Пакет вытеснен — нажмите «Копировать пакет», чтобы вставить снимки"
                       Visibility="{Binding PackageDisplaced, Converter={StaticResource BoolToVisibility}}" />

            <Button Style="{StaticResource AccentButton}" Height="40" Margin="0,10,0,0" Click="NewCapture_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="16" FontWeight="Normal"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Новый снимок" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
