<Window x:Class="Snapkit.App.Strip.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Snapkit.App.Shell"
        Title="Snapkit — Лента снимков"
        Width="240" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="{Binding IsTopmost}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <shell:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="10,6,10,10">
        <StackPanel>
            <!-- Заголовок: за него окно перетаскивается -->
            <Grid Height="34" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Width="18" Height="18" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Text="Snapkit" Margin="8,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="9" MinWidth="20" Height="18"
                        Padding="6,0" VerticalAlignment="Center" ToolTip="Неотправленных снимков">
                    <TextBlock Text="{Binding UnsentCount}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Очистить ленту" Click="Clear_Click" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Ещё" Click="More_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Свернуть" Click="Minimize_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Закрыть" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Пустая лента -->
            <Border Margin="0,6,0,0" Height="96" CornerRadius="8" Background="{StaticResource PanelRaisedBrush}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="14,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <!-- Карточки стопкой: каждая следующая наезжает на предыдущую, новая — снизу и видна целиком -->
            <ScrollViewer Margin="0,6,0,0" MaxHeight="460" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{Binding TopMargin}" />
                            <Style.Triggers>
                                <!-- Наведение поднимает карточку над стопкой — она видна целиком -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="100" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Height="124" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource PanelBorderBrush}" Background="{StaticResource PanelRaisedBrush}"
                                    Cursor="Hand" Tag="{Binding Id}" MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    ToolTip="Открыть снимок">
                                <Grid>
                                    <Border CornerRadius="7">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                                        </Border.Background>
                                    </Border>
                                    <!-- Тёмная полоса сверху, чтобы значки читались на любом снимке -->
                                    <Border Height="36" VerticalAlignment="Top" CornerRadius="7,7,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F21E2128" Offset="0" />
                                                <GradientStop Color="#801E2128" Offset="0.7" />
                                                <GradientStop Color="#001E2128" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="8,6,0,0" VerticalAlignment="Top">
                                        <Grid Width="22" Height="22">
                                            <Ellipse Fill="{StaticResource AccentBrush}"
                                                     Visibility="{Binding Letter, Converter={StaticResource NotNullToVisibility}}" />
                                            <TextBlock Text="{Binding Letter}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Fill="#40FFFFFF"
                                                     Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE90A;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding NoteCount}" Margin="5,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                            ToolTip="Удалить снимок" Tag="{Binding Id}" Click="Delete_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                            Foreground="White" Visibility="Hidden" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Margin="2,8,2,0" TextWrapping="Wrap" FontSize="12" Foreground="#FBBF5A"
                       Text="{Binding SoftWarningText}"
                       Visibility="{Binding ShowSoftWarning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="2,8,2,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                       Text="Пакет вытеснен — нажмите «Копировать пакет», чтобы вставить снимки"
                       Visibility="{Binding PackageDisplaced, Converter={StaticResource BoolToVisibility}}" />

            <Button Style="{StaticResource AccentButton}" Height="40" Margin="0,10,0,0" Click="NewCapture_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="16" FontWeight="Normal"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Новый снимок" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
