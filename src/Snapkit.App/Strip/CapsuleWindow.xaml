<Window x:Class="Snapkit.App.Strip.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapkit — Свёрнутая лента"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="{Binding IsTopmost}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- Капсула: за неё саму окно перетаскивается -->
    <Border Height="40" CornerRadius="20" Padding="4,4,6,4" Margin="6"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- Круглая кнопка нового снимка цвета акцента -->
            <Button Width="30" Height="30" Cursor="Hand" Focusable="False" ToolTip="Новый снимок" Click="NewCapture_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Snapkit" Margin="9,0,7,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource ChipBrush}" CornerRadius="9" MinWidth="20" Height="18" Padding="6,0"
                    VerticalAlignment="Center" ToolTip="Снимков на ленте">
                <TextBlock Text="{Binding CaptureCount}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Style="{StaticResource IconButton}" Width="26" Margin="4,0,0,0" Content="&#xE70E;"
                    ToolTip="Развернуть ленту" Click="Expand_Click" />
        </StackPanel>
    </Border>
</Window>
