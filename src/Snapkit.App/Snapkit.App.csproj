<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\snapkit.ico</ApplicationIcon>
    <AssemblyName>Snapkit</AssemblyName>
    <RootNamespace>Snapkit.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>Snapkit</Product>
    <!-- WFO0003 советует задавать DPI через API WinForms, но это WPF-приложение:
         для него режим PerMonitorV2 правильно задавать в app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только ради NotifyIcon: убираем его пространства имён из неявных using,
         чтобы не путались Application, MessageBox и т. п. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\snapkit.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snapkit.Core\Snapkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snapkit.App.Tests" />
  </ItemGroup>

</Project>
