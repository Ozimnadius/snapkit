<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\snapkit.ico</ApplicationIcon>
    <AssemblyName>Snapkit</AssemblyName>
    <RootNamespace>Snapkit.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>Snapkit</Product>
    <!-- В релизе версию задаёт метка git (v0.1.0 → 0.1.0), см. .github/workflows/release.yml -->
    <Version>0.3.1</Version>
    <!-- WFO0003 советует задавать DPI через API WinForms, но это WPF-приложение:
         для него режим PerMonitorV2 правильно задавать в app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Релиз — один Snapkit.exe без установленного .NET: dotnet publish -p:SnapkitRelease=true.
       Такой exe при запуске не из своей папки ставит себя сам (Shell/SelfInstall.cs). -->
  <PropertyGroup Condition="'$(SnapkitRelease)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только ради NotifyIcon: убираем его пространства имён из неявных using,
         чтобы не путались Application, MessageBox и т. п. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\snapkit.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snapkit.Core\Snapkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snapkit.App.Tests" />
  </ItemGroup>

</Project>
