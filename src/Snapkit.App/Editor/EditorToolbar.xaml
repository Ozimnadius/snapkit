<UserControl x:Class="Snapkit.App.Editor.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <!-- Кнопка инструмента: выбранный подсвечен цветом акцента -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Узкая часть кнопки группы: открывает меню вариантов -->
        <Style x:Key="ChevronButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Content" Value="&#xE70D;" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="6">
        <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="SelectTool" Style="{StaticResource ToolButton}" ToolTip="Выбор (V)" Tag="Select" Click="Tool_Click" />
            <ToggleButton x:Name="ShapeTool" Style="{StaticResource ToolButton}" Click="Group_Click" Tag="Shape" />
            <Button Style="{StaticResource ChevronButton}" ToolTip="Другие фигуры" Tag="Shape" Click="GroupMenu_Click" />
            <ToggleButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" Click="Group_Click" Tag="Arrow" />
            <Button Style="{StaticResource ChevronButton}" ToolTip="Другие стрелки" Tag="Arrow" Click="GroupMenu_Click" />
            <ToggleButton x:Name="LineTool" Style="{StaticResource ToolButton}" ToolTip="Линия (L)" Tag="Line" Click="Tool_Click" />
            <ToggleButton x:Name="PencilTool" Style="{StaticResource ToolButton}" Click="Group_Click" Tag="Pencil" />
            <Button Style="{StaticResource ChevronButton}" ToolTip="Карандаш или маркер" Tag="Pencil" Click="GroupMenu_Click" />
            <ToggleButton x:Name="TextTool" Style="{StaticResource ToolButton}" ToolTip="Текст (T)" Tag="Text" Click="Tool_Click" />
            <ToggleButton x:Name="EraserTool" Style="{StaticResource ToolButton}" ToolTip="Ластик (E)" Tag="Eraser" Click="Tool_Click" />
            <ToggleButton x:Name="BlurTool" Style="{StaticResource ToolButton}" ToolTip="Размыть (B)" Tag="Blur" Click="Tool_Click" />
            <ToggleButton x:Name="CropTool" Style="{StaticResource ToolButton}" ToolTip="Обрезать (X)" Tag="Crop" Click="Tool_Click" />
            <ToggleButton x:Name="PinTool" Style="{StaticResource ToolButton}" ToolTip="Комментарий (C)" Tag="Pin" Click="Tool_Click" />
            <Button Style="{StaticResource BarButton}" FontFamily="Segoe UI" FontWeight="SemiBold" Content="?"
                    ToolTip="Клавиши редактора (F1)" Click="Help_Click" />

            <Border Style="{StaticResource Divider}" />

            <Button x:Name="ColorButton" Style="{StaticResource BarButton}" ToolTip="Цвет" Click="ColorButton_Click">
                <Ellipse x:Name="ColorSwatch" Width="18" Height="18" Stroke="#80FFFFFF" StrokeThickness="1" />
            </Button>
            <Button x:Name="ThicknessButton" Style="{StaticResource BarButton}" Width="56" ToolTip="Толщина" Click="ThicknessButton_Click">
                <TextBlock x:Name="ThicknessText" FontFamily="Segoe UI" FontSize="12" />
            </Button>

            <Border Style="{StaticResource Divider}" />

            <Button x:Name="UndoButton" Style="{StaticResource BarButton}" Content="&#xE7A7;" ToolTip="Отменить (Ctrl+Z)" Click="Undo_Click" />
            <Button x:Name="RedoButton" Style="{StaticResource BarButton}" Content="&#xE7A6;" ToolTip="Повторить (Ctrl+Y)" Click="Redo_Click" />
            <Button Style="{StaticResource BarButton}" Content="&#xE8C8;" ToolTip="Копировать (Ctrl+Shift+C)" Click="Copy_Click" />

            <Button Style="{StaticResource AccentButton}" Height="36" Margin="6,0,0,0" Content="Готово"
                    ToolTip="Готово (Enter)" Click="Done_Click" />
        </StackPanel>
    </Border>
</UserControl>
