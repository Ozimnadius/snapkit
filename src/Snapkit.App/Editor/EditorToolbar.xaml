<UserControl x:Class="Snapkit.App.Editor.EditorToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <!-- Кнопка инструмента: выбранный подсвечен цветом акцента -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="6">
        <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="SelectTool" Style="{StaticResource ToolButton}" ToolTip="Выбор (V)" Tag="Select" Click="Tool_Click">
                <Path Data="M0,0 L0,15 L4,11.2 L6.8,17 L9.4,15.8 L6.7,10.2 L12,10.2 Z" StrokeThickness="0"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </ToggleButton>
            <ToggleButton x:Name="RectangleTool" Style="{StaticResource ToolButton}" Content="&#xE739;" ToolTip="Прямоугольник (R)" Tag="Rectangle" Click="Tool_Click" />
            <ToggleButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" ToolTip="Стрелка (A)" Tag="Arrow" Click="Tool_Click">
                <Path Data="M1,15 L14,2 M6,2 L14,2 L14,10" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            </ToggleButton>
            <ToggleButton x:Name="TextTool" Style="{StaticResource ToolButton}" Content="&#xE8D2;" ToolTip="Текст (T)" Tag="Text" Click="Tool_Click" />
            <ToggleButton x:Name="PinTool" Style="{StaticResource ToolButton}" Content="&#xE90A;" ToolTip="Комментарий (C)" Tag="Pin" Click="Tool_Click" />

            <Border Style="{StaticResource Divider}" />

            <Button x:Name="ColorButton" Style="{StaticResource BarButton}" ToolTip="Цвет" Click="ColorButton_Click">
                <Ellipse x:Name="ColorSwatch" Width="18" Height="18" Stroke="#80FFFFFF" StrokeThickness="1" />
            </Button>
            <Button x:Name="ThicknessButton" Style="{StaticResource BarButton}" Width="56" ToolTip="Толщина" Click="ThicknessButton_Click">
                <TextBlock x:Name="ThicknessText" FontFamily="Segoe UI" FontSize="12" />
            </Button>

            <Border Style="{StaticResource Divider}" />

            <Button x:Name="UndoButton" Style="{StaticResource BarButton}" Content="&#xE7A7;" ToolTip="Отменить (Ctrl+Z)" Click="Undo_Click" />
            <Button x:Name="RedoButton" Style="{StaticResource BarButton}" Content="&#xE7A6;" ToolTip="Повторить (Ctrl+Y)" Click="Redo_Click" />
            <Button Style="{StaticResource BarButton}" Content="&#xE8C8;" ToolTip="Копировать (Ctrl+Shift+C)" Click="Copy_Click" />

            <Button Style="{StaticResource AccentButton}" Height="36" Margin="6,0,0,0" Content="Готово"
                    ToolTip="Готово (Enter)" Click="Done_Click" />
        </StackPanel>
    </Border>
</UserControl>
