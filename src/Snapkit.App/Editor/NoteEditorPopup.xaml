<UserControl x:Class="Snapkit.App.Editor.NoteEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12,8,6,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="Placeholder" Text="Комментарий…" Foreground="{StaticResource MutedTextBrush}"
                           IsHitTestVisible="False" Margin="2,0,0,0" />
                <TextBox x:Name="NoteText" Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{StaticResource TextBrush}" CaretBrush="White" TextWrapping="Wrap"
                         AcceptsReturn="True" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                         TextChanged="NoteText_TextChanged" PreviewKeyDown="NoteText_PreviewKeyDown" />
            </Grid>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11"
                    Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Top"
                    ToolTip="Закрыть (Esc)" Click="Close_Click" />
        </Grid>
    </Border>
</UserControl>
