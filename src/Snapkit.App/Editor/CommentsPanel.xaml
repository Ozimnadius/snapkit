<UserControl x:Class="Snapkit.App.Editor.CommentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="14,12">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Комментарии" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="Комментарий к снимку" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,6" />
                <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="8" Padding="8,6">
                    <TextBox x:Name="SnapshotNoteText" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="54" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                             TextChanged="SnapshotNoteText_TextChanged" />
                </Border>
            </StackPanel>

            <Grid>
                <TextBlock x:Name="EmptyText" Text="Нет комментариев" Foreground="{DynamicResource MutedTextBrush}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,5" Cursor="Hand"
                                        Tag="{Binding Id}" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="11" MinWidth="26" Height="22"
                                                Padding="5,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="8,2,4,0" />
                                        <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                                Content="&#xE8BB;" FontSize="10" Width="22" Height="22" VerticalAlignment="Top"
                                                ToolTip="Удалить комментарий" Tag="{Binding Id}" Click="Remove_Click"
                                                Visibility="Hidden" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
