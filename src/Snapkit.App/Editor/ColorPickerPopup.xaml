<UserControl x:Class="Snapkit.App.Editor.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="268" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="#80FFFFFF" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="14,10,10,12">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock x:Name="Title" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Width="24" Height="24"
                        HorizontalAlignment="Right" ToolTip="Закрыть (Esc)" Click="Close_Click" />
            </Grid>

            <WrapPanel x:Name="PaletteRow" />
            <TextBlock x:Name="CustomTitle" Text="Свои цвета" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" />
            <WrapPanel x:Name="CustomRow" />

            <TextBlock Text="Оттенок" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,2" />
            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="Hsv_ValueChanged" />
            <TextBlock Text="Яркость" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,2" />
            <Slider x:Name="ValueSlider" Minimum="0" Maximum="1" ValueChanged="Hsv_ValueChanged" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Preview" Width="28" Height="28" CornerRadius="6" BorderBrush="#80FFFFFF" BorderThickness="1" />
                <TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0" Padding="4,3" VerticalContentAlignment="Center"
                         Background="#14FFFFFF" Foreground="{StaticResource TextBrush}" CaretBrush="White"
                         BorderBrush="{StaticResource PanelBorderBrush}" FontFamily="Consolas" FontSize="13"
                         ToolTip="Код цвета, например #E53935. Enter — выбрать" PreviewKeyDown="HexBox_PreviewKeyDown" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Выбрать" Height="28" Click="Choose_Click" />
            </Grid>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Width="Auto" Height="30" Margin="0,8,0,0"
                    Click="Pipette_Click" ToolTip="Взять цвет со снимка">
                <StackPanel Orientation="Horizontal" Margin="6,0,8,0">
                    <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Пипетка" FontFamily="Segoe UI" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
